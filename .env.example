# Native app environment example
# Copy this file to native_app/.env and adjust values as needed.

# Core
PROJECT_NAME=PixelStarships Logger
VERSION=1.0.0

# Local database (SQLite)
# When running from native_app/, this resolves to native_app/pss_logger.db
DATABASE_URL=sqlite:///./pss_logger.db

# Allowed hosts (used by migrated service config)
ALLOWED_HOSTS=http://127.0.0.1:8877,http://localhost:8877

# Pixel Starships API
PSS_API_BASE_URL=https://api.pixelstarships.com
PSS_API_REQUEST_TIMEOUT_SECONDS=20
PSS_CHECKSUM_KEY=

# Cache TTLs
DESIGNS_CACHE_TTL_SECONDS=86400
ITEMS_API_CACHE_TTL_SECONDS=86400
BATTLE_REPORT_CACHE_TTL_SECONDS=3600
