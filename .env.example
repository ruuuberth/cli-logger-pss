# Variables de entorno para Docker Compose
# Copiar este archivo a .env y modificar según sea necesario

# Base de Datos
POSTGRES_DB=pixelstarships
POSTGRES_USER=pss_user
POSTGRES_PASSWORD=pss_password

# Backend
DATABASE_URL=postgresql://pss_user:pss_password@db:5432/pixelstarships
ALLOWED_HOSTS=http://localhost:3000,http://frontend,http://127.0.0.1:3000
PSS_API_BASE_URL=https://api.pixelstarships.com

# Frontend
REACT_APP_API_URL=http://localhost:8000

# Puertos
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_PORT=5432
REDIS_PORT=6379

# Entorno
NODE_ENV=production
DEBUG=false