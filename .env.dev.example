# Native app development environment example
# Copy this file to native_app/.env for local development.

PROJECT_NAME=PixelStarships Logger (Dev)
VERSION=1.0.0-dev

DATABASE_URL=sqlite:///./pss_logger_dev.db
ALLOWED_HOSTS=http://127.0.0.1:8877,http://localhost:8877

PSS_API_BASE_URL=https://api.pixelstarships.com
PSS_API_REQUEST_TIMEOUT_SECONDS=20
PSS_CHECKSUM_KEY=

DESIGNS_CACHE_TTL_SECONDS=300
ITEMS_API_CACHE_TTL_SECONDS=86400
BATTLE_REPORT_CACHE_TTL_SECONDS=300
