# Variables de entorno para Docker Compose (Desarrollo)
# Copiar este archivo a .env.dev y modificar según sea necesario

# Base de Datos
POSTGRES_DB=pixelstarships_dev
POSTGRES_USER=pss_user
POSTGRES_PASSWORD=pss_password

# Backend
DATABASE_URL=postgresql://pss_user:pss_password@db:5432/pixelstarships_dev
ALLOWED_HOSTS=http://localhost:3001,http://frontend,http://127.0.0.1:3001
PSS_API_BASE_URL=https://api.pixelstarships.com

# Frontend
REACT_APP_API_URL=http://localhost:8001

# Puertos (diferentes a producción)
BACKEND_PORT=8001
FRONTEND_PORT=3001
DB_PORT=5433
REDIS_PORT=6379

# Entorno
NODE_ENV=development
DEBUG=true