# Native app development environment example
# Copy this file to native_app/.env for local development.

PROJECT_NAME=PixelStarships Logger (Dev)
VERSION=1.0.0-dev

DATABASE_URL=sqlite:///./pss_logger_dev.db
ALLOWED_HOSTS=http://127.0.0.1:8877,http://localhost:8877

PSS_API_BASE_URL=https://api.pixelstarships.com
PSS_API_REQUEST_TIMEOUT_SECONDS=20
PSS_CHECKSUM_KEY=

DESIGNS_CACHE_TTL_SECONDS=300
ITEMS_API_CACHE_TTL_SECONDS=86400
BATTLE_REPORT_CACHE_TTL_SECONDS=300

# API Flow (mitmproxy)
API_FLOW_ENABLED=true
MITMPROXY_BINARY=mitmdump
MITMPROXY_LISTEN_HOST=127.0.0.1
MITMPROXY_LISTEN_PORT=8081
API_FLOW_BODY_MAX_CHARS=4000
API_FLOW_RETENTION_DAYS=7
API_FLOW_MAX_DB_MB=512
API_FLOW_CAPTURE_HTTPS=true
API_FLOW_IGNORE_HOSTS=player-auth.services.api.unity.com,config.services.api.unity.com,collect.analytics.unity3d.com
API_FLOW_CAPTURE_HOST_ALLOWLIST=api.pixelstarships.com
API_FLOW_CAPTURE_PATH_ALLOWLIST=/BattleService/GetBattle3
